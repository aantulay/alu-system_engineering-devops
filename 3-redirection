#!/usr/bin/env bash
# Configures Nginx with a 301 redirect for /redirect_me

apt-get update -y
apt-get install nginx -y

# Insert the redirection rule inside the server block of the default Nginx config
CFG_FILE="/etc/nginx/sites-available/default"
sudo sed -i '/listen 80 default_server;/a \    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }' "$CFG_FILE"

service nginx restart
