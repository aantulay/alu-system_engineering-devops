#!/usr/bin/env bash
# Installs and configures HAProxy to load balance traffic between web-01 and web-02 using roundrobin

apt-get update -y
apt-get install -y haproxy

# Enable HAProxy to be run by init script
sed -i 's/^ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Configure HAProxy frontend and backend defaults/servers
cat << 'EOF' > /etc/haproxy/haproxy.cfg
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	user haproxy
	group haproxy
	daemon

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend haproxy_frontend
    bind *:80
    default_backend haproxy_backend

backend haproxy_backend
    balance roundrobin
    server 7242-web-01 52.56.93.14:80 check
    server 7242-web-02 13.40.173.255:80 check
EOF

# Restart HAProxy service using init script (without systemctl)
service haproxy restart
