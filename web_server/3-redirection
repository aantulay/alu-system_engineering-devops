#!/usr/bin/env bash
# Configures Nginx with a 301 Moved Permanently redirection for /redirect_me to a YouTube video

apt-get update -y
apt-get install nginx -y

# Add the 301 redirection block inside the default server block using sed
sed -i "/server_name _;/a \    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }" /etc/nginx/sites-enabled/default

# Restart Nginx without systemctl
service nginx restart
