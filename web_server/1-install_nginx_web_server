#!/usr/bin/env bash
# Installs Nginx, configures the root page to return "Holberton School", and starts Nginx without systemctl

# Update package lists and install nginx non-interactively
apt-get update -y
apt-get install -y nginx

# Write the required string to Nginx's default index page
echo "Holberton School for the win!" > /var/www/html/index.html

# Ensure the service is started using init.d or service command (without systemctl)
service nginx start || /etc/init.d/nginx start
