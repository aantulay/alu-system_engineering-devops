#!/usr/bin/env bash
# Installs Nginx web server and configures root response to contain Holberton School

apt-get update -y
apt-get install -y nginx

# Create the index page with the required string
echo "Holberton School" > /var/www/html/index.html

# Ensure Nginx site configuration explicitly points to /var/www/html
sed -i 's|root /var/www/html;|root /var/www/html;\n\tindex index.html index.htm index.nginx-debian.html;|g' /etc/nginx/sites-enabled/default

# Restart Nginx without systemctl
service nginx restart
